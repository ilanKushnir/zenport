# ZenPort configuration
# Any ZP_* variable also accepts a ZP_*_FILE variant pointing at a file
# containing the value (recommended for secrets, e.g. Docker secrets).

# --- Host paths and ports (read by docker-compose.yml, not by the server) ---
# Where your meditation library lives ON THE HOST. The stock compose file
# mounts it read-only at /library/meditations, so this is the only line you
# have to change to point ZenPort at your files. Default: the bundled
# sample library committed in this repo.
ZP_MEDITATION_PATH=./fixtures/library/meditations
# Host port published for the web UI. The container always listens on 8484.
ZP_HTTP_PORT=8484

# --- Core (bare-metal runs; the container sets its own) ---
# Port the web/API server listens on.
ZP_PORT=8484
# Bind address. Default 127.0.0.1; the image sets 0.0.0.0.
ZP_HOST=0.0.0.0
# Writable state directory (SQLite database, voice notes). Local disk only.
ZP_DATA_DIR=/data
# Comma-separated list of read-only meditation library roots.
ZP_LIBRARY_DIRS=/library/meditations

# --- Security ---
# Secret used for session material. REQUIRED in production.
# Generate one: openssl rand -hex 32
ZP_SESSION_SECRET=
# Optional lock on first-run setup. Leave it empty and you simply open the
# app and create your admin account; the window closes for good once that
# account exists. Set it if the server is reachable from somewhere hostile
# before you have finished setting up. Generate: openssl rand -hex 16
ZP_SETUP_TOKEN=
# Set to "1" only when ZenPort is served over HTTPS (enables the Secure
# cookie flag). PWA installation and service workers require HTTPS.
ZP_TRUST_HTTPS=0
# Session lifetime in days.
ZP_SESSION_DAYS=30

# --- Library refresh ---
# Minutes between automatic rescans. 0 disables (manual rescans only).
ZP_SCAN_INTERVAL_MINUTES=60

# --- Optional integrations (all off by default; nothing calls out unless
# --- you configure it and then use it) ---
# Absolute path to a yt-dlp executable for metadata-only playlist/channel
# listing on the Sources page. Empty = the import UI shows an honest
# unavailable state.
ZP_YTDLP_PATH=
# Whisper-compatible transcription endpoint for journal voice notes, e.g.
# http://faster-whisper.lan:8000/v1/audio/transcriptions
# Empty = transcription is disabled; voice notes still record and play.
ZP_TRANSCRIBE_URL=
# Bearer token for that endpoint, if it wants one.
ZP_TRANSCRIBE_API_KEY=
# Model name sent to the endpoint.
ZP_TRANSCRIBE_MODEL=whisper-1

# --- Container runtime (entrypoint) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Misc ---
# Log level: fatal|error|warn|info|debug|trace
ZP_LOG_LEVEL=info
